---
import PageTexte from '../components/PageTexte.astro';
import { SITE } from '../data/site';
---
<PageTexte title="Mentions légales | L'Atelier du Coloriste, Montmorency" description="Mentions légales du site de L'Atelier du Coloriste, salon de coloration au 1 rue de l'Église, 95160 Montmorency : éditeur, hébergeur, propriété intellectuelle." h1="Mentions légales">
  <h2>Éditeur du site</h2>
  <p>{SITE.nom}, exploité par la société {SITE.societe}<br />
  Forme juridique : <span class="ac">[À CONFIRMER]</span> · Capital social : <span class="ac">[À CONFIRMER]</span><br />
  SIRET : <span class="ac">[À CONFIRMER]</span> · RCS : <span class="ac">[À CONFIRMER]</span><br />
  N° TVA intracommunautaire : <span class="ac">[À CONFIRMER]</span><br />
  Adresse : {SITE.adresseTexte} (siège social <span class="ac">[À CONFIRMER]</span>)<br />
  Téléphone : <a href={`tel:${SITE.telLien}`}>{SITE.telAffiche}</a><br />
  E-mail : <span class="ac">[À CONFIRMER]</span></p>
  <p>Directrice de la publication : Barbara <span class="ac">[À CONFIRMER : nom de famille]</span></p>

  <h2>Hébergeur</h2>
  <p>Vercel Inc., 440 N Barranca Ave #4133, Covina, CA 91723, États-Unis. Site&nbsp;: <a href="https://vercel.com" target="_blank" rel="noopener">vercel.com</a></p>

  <h2>Propriété intellectuelle</h2>
  <p>Les textes, photos et éléments graphiques de ce site appartiennent à {SITE.nom}, sauf mention contraire. Toute reproduction sans autorisation est interdite.</p>

  <h2>Avis clients</h2>
  <p>Les extraits d'avis cités proviennent d'avis publics laissés sur Google. La note de {SITE.note}/5 sur {SITE.nbAvis} avis correspond à la fiche Google du salon à la date de mise en ligne du site.</p>

  <h2>Tarifs</h2>
  <p>Les tarifs éventuellement indiqués sont donnés à titre indicatif et confirmés au salon avant la prestation.</p>

  <h2>Données personnelles</h2>
  <p>Voir la <a href="/confidentialite/">politique de confidentialité</a>.</p>
</PageTexte>
