---
import '../styles/global.css';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import BarreMobile from '../components/BarreMobile.astro';
import { SITE, HORAIRES } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonld?: object[];
  noindex?: boolean;
}
const { title, description, jsonld = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);

const jours = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const ouverture = HORAIRES.flatMap((h) =>
  h.plages.map(([opens, closes]) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${jours[h.jour]}`, opens, closes })),
);

const salon: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  '@id': new URL('/#salon', Astro.site).href,
  name: SITE.nom,
  description: "Salon de coiffure spécialisé en coloration à Montmorency (Val-d'Oise) : balayage, ombré, coloration, patine, cheveux gris et blancs assumés, rattrapage de couleurs ratées, coupe. Sur rendez-vous uniquement.",
  url: new URL('/', Astro.site).href,
  telephone: SITE.telLien,
  image: og.href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.adresse.rue,
    postalCode: SITE.adresse.cp,
    addressLocality: SITE.adresse.ville,
    addressRegion: "Val-d'Oise",
    addressCountry: SITE.adresse.pays,
  },
  hasMap: SITE.itineraire,
  areaServed: [SITE.adresse.ville, ...SITE.voisines].map((n) => ({ '@type': 'City', name: n })),
  openingHoursSpecification: ouverture,
  paymentAccepted: 'Espèces, chèques',
  currenciesAccepted: 'EUR',
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Entrée accessible en fauteuil roulant', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Parking accessible en fauteuil roulant', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Toilettes accessibles en fauteuil roulant', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Boucle magnétique pour personnes malentendantes', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Sur rendez-vous uniquement', value: true },
  ],
  aggregateRating: { '@type': 'AggregateRating', ratingValue: SITE.noteNum, bestRating: 5, reviewCount: SITE.nbAvis },
};
if (SITE.reseaux.length) salon.sameAs = SITE.reseaux;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBFAF7" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="L'Atelier du Coloriste, Barbara coloriste à Montmorency : nuancier de mèches" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(salon)} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-atelier focus:px-4 focus:py-3 focus:font-semibold">Aller au contenu</a>
    <Entete />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Pied />
    <BarreMobile />
    <script is:inline define:vars={{ horaires: HORAIRES }}>
      (function () {
        try {
          var parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Paris', weekday: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());
          var get = function (t) { return (parts.find(function (p) { return p.type === t; }) || {}).value; };
          var idx = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
          var noms = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];
          var j = idx[get('weekday')];
          var min = parseInt(get('hour'), 10) * 60 + parseInt(get('minute'), 10);
          var toMin = function (h) { var a = h.split(':'); return +a[0] * 60 + +a[1]; };
          var fmt = function (h) { return h.replace(':00', 'h').replace(':', 'h'); };
          var jour = function (n) { return horaires.find(function (h) { return h.jour === n; }); };
          var auj = jour(j);
          var plage = auj && auj.plages.find(function (p) { return min >= toMin(p[0]) && min < toMin(p[1]); });
          var texte;
          if (plage) texte = 'Ouvert maintenant, jusqu’à ' + fmt(plage[1]);
          else {
            var suivante = auj && auj.plages.find(function (p) { return min < toMin(p[0]); });
            if (suivante) texte = 'Fermé, ouvre à ' + fmt(suivante[0]) + ' aujourd’hui';
            else {
              for (var k = 1; k <= 7; k++) {
                var d = jour((j + k) % 7);
                if (d && d.plages.length) { texte = 'Fermé, ouvre ' + (k === 1 ? 'demain' : noms[d.jour]) + ' à ' + fmt(d.plages[0][0]); break; }
              }
            }
          }
          document.querySelectorAll('[data-statut]').forEach(function (el) {
            el.dataset.ouvert = plage ? 'oui' : 'non';
            var t = el.querySelector('[data-statut-texte]');
            if (t && texte) t.textContent = texte;
          });
          document.querySelectorAll('[data-jour="' + j + '"]').forEach(function (el) { el.setAttribute('aria-current', 'date'); });
        } catch (e) {}
      })();
    </script>
  </body>
</html>
