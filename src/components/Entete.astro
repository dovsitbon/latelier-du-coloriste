---
import { SITE } from '../data/site';
const accueil = Astro.url.pathname === '/';
---
<header class="wrap flex items-center justify-between gap-4 pt-5 pb-3 md:pt-7">
  <a href="/" class="no-underline flex items-center gap-3 min-h-[44px]" aria-current={accueil ? 'page' : undefined}>
    <svg viewBox="0 0 40 40" class="w-9 h-9 shrink-0" aria-hidden="true">
      <circle cx="20" cy="20" r="19" fill="#161514" />
      <path d="M13 10c1 9 0 15 3 22M20 9c0 9 0 16 0 23M27 10c-1 9 0 15-3 22" stroke="#C99A4B" stroke-width="2.4" fill="none" stroke-linecap="round" />
    </svg>
    <span translate="no" class="font-titre text-[1.28rem] md:text-[1.45rem] leading-none">L'Atelier du Coloriste</span>
  </a>
  <a href={`tel:${SITE.telLien}`} class="hidden md:inline-flex btn btn-ligne !min-h-[46px] !py-2">Appeler le {SITE.telAffiche}</a>
</header>
