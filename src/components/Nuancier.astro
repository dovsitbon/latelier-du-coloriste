---
// Nuancier de mèches : six échantillons dessinés en SVG, qui servent de navigation vers les sections.
// Survol ou focus clavier : la mèche se soulève et affiche ce qu'on trouve dans la section.
// Flèches gauche/droite, Début/Fin : passer d'une mèche à l'autre au clavier.
import { TEINTES } from '../data/site';

// Générateur pseudo-aléatoire déterministe : mêmes mèches à chaque build.
const rnd = (seed: number) => () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

const angles = [-7, -4.2, -1.4, 1.4, 4.2, 7];

const meches = TEINTES.map((t, i) => {
  const r = rnd(97 + i * 131);
  const sway = (r() - 0.5) * 26; // déport de la pointe
  const tipX = 50 + sway;
  // Contour de la mèche : attache large, léger gonflement, pointe effilée.
  const contour = `M14 0 L86 0 C 90 90, ${88 + sway * 0.3} 210, ${72 + sway * 0.7} 300 C ${64 + sway} 350, ${tipX + 6} 385, ${tipX} 400 C ${tipX - 5} 384, ${36 + sway} 350, ${28 + sway * 0.7} 300 C ${14 + sway * 0.3} 210, 10 90, 14 0 Z`;
  // Fibres : traits fins qui convergent vers la pointe.
  const fibres = Array.from({ length: 22 }, (_, k) => {
    const x0 = 16 + (k / 21) * 68 + (r() - 0.5) * 3;
    const end = 0.78 + r() * 0.2;
    const x1 = tipX + (x0 - 50) * (1 - end) * 0.9;
    const y1 = 400 * end;
    const cx = x0 + (x1 - x0) * 0.45 + (r() - 0.5) * 8;
    return {
      d: `M${x0.toFixed(1)} 0 Q ${cx.toFixed(1)} ${(y1 * 0.55).toFixed(1)} ${x1.toFixed(1)} ${y1.toFixed(1)}`,
      clair: k % 3 !== 0,
      w: (0.5 + r() * 0.9).toFixed(2),
      o: (0.35 + r() * 0.4).toFixed(2),
    };
  });
  return { ...t, contour, fibres, angle: angles[i], index: i + 1 };
});
---
<nav class="nuancier" aria-label="Nuancier : les six parties du site" data-nuancier>
  <ul>
    {meches.map((m) => (
      <li style={`--t:${m.hex};--r:${m.angle}deg`}>
        <a class="meche" href={`#${m.id}`} data-meche>
          <span class="attache">
            <span class="trou" aria-hidden="true"></span>
            <span class="code">{m.code}</span>
            <span class="teinte">{m.nom}</span>
          </span>
          <svg class="fibre" viewBox="0 0 100 400" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id={`g-${m.id}`} x1="0" x2="1" y1="0" y2="0">
                <stop offset="0" stop-color={m.fonce} />
                <stop offset=".35" stop-color={m.hex} />
                <stop offset=".55" stop-color={m.clair} />
                <stop offset=".75" stop-color={m.hex} />
                <stop offset="1" stop-color={m.fonce} />
              </linearGradient>
              <clipPath id={`c-${m.id}`}><path d={m.contour} /></clipPath>
            </defs>
            <path d={m.contour} fill={`url(#g-${m.id})`} />
            <g clip-path={`url(#c-${m.id})`} fill="none" stroke-linecap="round">
              {m.fibres.map((f) => (
                <path d={f.d} stroke={f.clair ? m.clair : m.fonce} stroke-width={f.w} opacity={f.o} />
              ))}
            </g>
          </svg>
          <span class="etiquette">
            <span class="section">{m.section}</span>
            <span class="note">{m.note}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="aide">Chaque mèche ouvre une partie du site. Au clavier : Tab ou les flèches.</p>
</nav>

<style>
  .nuancier { position: relative; padding-top: 1.1rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: .9rem; row-gap: 2.2rem; }
  li { position: relative; min-width: 0; }
  /* La tige métallique sur laquelle les mèches sont enfilées */
  li::before { content: ''; position: absolute; z-index: 4; top: -.3rem; left: -.5rem; right: -.5rem; height: 4px; background: #2A2724; border-radius: 2px; }
  li:first-child::before, li:nth-child(4)::before { left: -1.25rem; }
  li:nth-child(3)::before, li:last-child::before { right: -1.25rem; }

  .meche { position: relative; display: flex; flex-direction: column; align-items: center; text-decoration: none; color: var(--color-encre); transform-origin: 50% -.1rem; transform: rotate(var(--r)); transition: transform .45s cubic-bezier(.2, .8, .25, 1); outline-offset: 6px; border-radius: 6px; -webkit-tap-highlight-color: transparent; }

  .attache { position: relative; z-index: 3; width: 88%; margin-top: -.85rem; padding: 1.35rem .3rem .5rem; background: #FFFFFF; border: 1px solid #D8D3CA; border-radius: 6px 6px 3px 3px; display: flex; flex-direction: column; align-items: center; gap: .1rem; text-align: center; box-shadow: 0 1px 0 rgb(0 0 0 / .04); }
  .trou { position: absolute; top: .38rem; left: 50%; width: .7rem; height: .7rem; margin-left: -.35rem; border-radius: 50%; background: var(--color-atelier); box-shadow: inset 0 0 0 1.5px #2A2724; }
  .code { font-family: var(--font-titre); font-size: 1.05rem; line-height: 1; font-variant-numeric: tabular-nums; }
  .teinte { display: block; font-size: .78rem; line-height: 1.2; color: var(--color-encre-2); }

  .fibre { display: block; width: 62%; height: 9.5rem; margin-top: -2px; }

  .etiquette { margin-top: .55rem; display: flex; flex-direction: column; align-items: center; text-align: center; min-height: 2.6rem; }
  .section { font-family: var(--font-titre); font-size: 1.05rem; line-height: 1.12; }
  .note { display: none; }

  .aide { margin-top: 1.8rem; font-size: .9rem; color: var(--color-encre-2); }

  @media (min-width: 640px) {
    ul { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: .7rem; }
    li::before, li:nth-child(4)::before, li:nth-child(3)::before { left: -.4rem; right: -.4rem; }
    li:first-child::before { left: -1.25rem; }
    li:last-child::before { right: -1.25rem; }
    .fibre { width: 66%; height: 13rem; }
    .section { font-size: 1rem; }
  }

  @media (min-width: 768px) {
    li:first-child::before { left: -2.5rem; }
    li:last-child::before { right: -2.5rem; }
  }

  @media (min-width: 1024px) {
    ul { column-gap: 1.25rem; }
    li::before, li:nth-child(4)::before, li:nth-child(3)::before { left: -.7rem; right: -.7rem; }
    li:first-child::before { left: -2.5rem; }
    li:last-child::before { right: -2.5rem; }
    .attache { width: 70%; padding: 1.5rem .4rem .6rem; }
    .code { font-size: 1.45rem; }
    .teinte { font-size: .85rem; }
    .fibre { width: 54%; height: 20rem; }
    .etiquette { min-height: 7.4rem; }
    .section { font-size: 1.4rem; }
    .note { display: block; max-width: 15ch; margin-top: .35rem; font-size: .92rem; line-height: 1.35; color: var(--color-encre-2); opacity: 0; transform: translateY(-6px); transition: opacity .3s, transform .35s; }
  }

  /* Survol et focus clavier : la mèche se soulève, se redresse et dévoile sa prestation. */
  /* Pivot sur le trou de l'attache : la mèche reste enfilée sur la tige, se redresse et vient vers l'avant. */
  .meche:hover, .meche:focus-visible { transform: rotate(0deg) scale(1.07); z-index: 5; }
  .fibre { transition: filter .45s; }
  .meche:hover .fibre, .meche:focus-visible .fibre { filter: drop-shadow(0 14px 12px rgb(22 21 20 / .28)); }
  .meche:hover .note, .meche:focus-visible .note { opacity: 1; transform: none; }
  .meche:hover .section, .meche:focus-visible .section { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; text-decoration-color: var(--t); }
  .meche:focus-visible { outline: 2px solid var(--color-encre); }
  .meche:active { transform: rotate(0deg) scale(1.03); }

  @media (prefers-reduced-motion: reduce) {
    .meche, .meche:hover, .meche:focus-visible { transform: none; }
    .note { opacity: 1 !important; transform: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-nuancier]').forEach((nav) => {
    const meches = Array.from(nav.querySelectorAll<HTMLAnchorElement>('[data-meche]'));
    nav.addEventListener('keydown', (e) => {
      const i = meches.indexOf(document.activeElement as HTMLAnchorElement);
      if (i < 0) return;
      let n = -1;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % meches.length;
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + meches.length) % meches.length;
      else if (e.key === 'Home') n = 0;
      else if (e.key === 'End') n = meches.length - 1;
      if (n < 0) return;
      e.preventDefault();
      meches[n].focus();
    });
  });
</script>
