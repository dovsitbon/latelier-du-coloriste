---
import { SITE } from '../data/site';
const annee = new Date().getFullYear();
---
<footer class="bg-encre text-atelier pb-24 md:pb-0">
  <div class="wrap py-12 md:py-14 grid grid-cols-1 gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <p class="font-titre text-[1.7rem] leading-tight">{SITE.nom}</p>
      <p class="mt-2 text-[#CFCAC2]">Barbara, coloriste à Montmorency. Sur rendez-vous uniquement.</p>
    </div>
    <address class="not-italic leading-relaxed">
      {SITE.adresse.rue}<br />{SITE.adresse.cp} {SITE.adresse.ville}<br />
      <a href={`tel:${SITE.telLien}`} class="inline-flex min-h-[44px] items-center underline underline-offset-4">{SITE.telAffiche}</a>
    </address>
    <div class="leading-relaxed">
      <p>Mercredi au samedi, 10h à 20h</p>
      <p>Espèces et chèques uniquement</p>
      <ul class="mt-3 flex flex-wrap gap-x-5">
        <li><a href="/mentions-legales/" class="inline-flex min-h-[44px] items-center underline underline-offset-4">Mentions légales</a></li>
        <li><a href="/confidentialite/" class="inline-flex min-h-[44px] items-center underline underline-offset-4">Confidentialité</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap pb-8 text-[.9rem] text-[#CFCAC2]">
    <p>© {annee} {SITE.nom}. Coloriste à Montmorency, pour {SITE.voisines.slice(0, 5).join(', ')} et alentours.</p>
  </div>
</footer>
