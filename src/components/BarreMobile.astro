---
import { SITE } from '../data/site';
---
<div class="md:hidden fixed inset-x-0 bottom-0 z-30 bg-encre grid grid-cols-[1fr_auto_auto] gap-2 p-2.5 pb-[max(.625rem,env(safe-area-inset-bottom))]">
  <a href={`tel:${SITE.telLien}`} class="btn btn-clair whitespace-nowrap !px-3">Appeler</a>
  <a href={SITE.smsLien} class="btn btn-ligne-clair !px-4">SMS</a>
  <a href={SITE.itineraire} class="btn btn-ligne-clair !px-4" target="_blank" rel="noopener">Itinéraire</a>
</div>
